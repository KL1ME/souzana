# Backend only. Copy to .env.themis and set these locally or in your host's secrets.
# Never prefix the API key with NEXT_PUBLIC_ or put it in a GitHub Pages build.
OPENAI_API_KEY=
# Default supports Responses, structured outputs, and web search.
OPENAI_MODEL=gpt-6-luna
THEMIS_HOST=127.0.0.1
THEMIS_PORT=8787
THEMIS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Anonymous API limits; Origin is not authentication. Socket peers are used, never client-supplied proxy headers.
# With a reverse proxy, visitors can share a socket-peer quota.
THEMIS_REQUESTS_PER_MINUTE=12
# Per socket peer, in a separate 10-second window.
THEMIS_REQUEST_BURST=4
THEMIS_GLOBAL_REQUESTS_PER_MINUTE=60
# Count each generation attempt, including failures, scope decisions and database/web/fallback stages.
# Process-local safety ceilings: restart resets them and replicas each have their own budget.
# These bound generation attempts, not currency, token spend, managed-index retrieval or provider-internal search calls.
THEMIS_PROVIDER_CALLS_PER_HOUR=300
THEMIS_PROVIDER_CALLS_PER_DAY=1000
THEMIS_MAX_CONCURRENT_REQUESTS=4
THEMIS_TIMEOUT_MS=60000
THEMIS_BODY_TIMEOUT_MS=10000
# Local file or a path on your backend host's persistent volume.
THEMIS_DATABASE_PATH=data/themis.sqlite
THEMIS_WEB_SEARCH_ENABLED=true
THEMIS_WEB_ALLOWED_DOMAINS=gov.gr,et.gr,europa.eu,dsa.gr
# Optional unverified model knowledge after both evidence sources are exhausted.
THEMIS_ALLOW_GENERAL_FALLBACK=false
# Enable after configuring access, approving documents, and completing manual sync.
THEMIS_DRIVE_ENABLED=false
THEMIS_DRIVE_FOLDER_ID=
# Backend-only Google credential file for a dedicated read-only identity.
THEMIS_GOOGLE_CREDENTIALS_FILE=
THEMIS_DRIVE_CATALOGUE_PATH=data/themis-drive.json
# Optional: themis:drive init records a newly created store ID in the catalogue.
THEMIS_VECTOR_STORE_ID=
# The remote catalogue fails closed after this many hours without successful sync.
THEMIS_DRIVE_MAX_AGE_HOURS=24
