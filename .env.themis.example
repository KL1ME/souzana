# Backend only. Copy to .env.themis and set these locally or in your host's secrets.
# Never prefix the API key with NEXT_PUBLIC_ or put it in a GitHub Pages build.
OPENAI_API_KEY=
# Set an enabled Responses API model ID from your OpenAI project.
OPENAI_MODEL=
THEMIS_HOST=127.0.0.1
THEMIS_PORT=8787
THEMIS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
